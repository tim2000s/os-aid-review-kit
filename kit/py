#!/bin/sh
# Generated by os-aid-review-kit. Runs a kit script with the first Python 3.11.4 or newer on the path
# (3.11.4 for tarfile's data filter, which making the live copy relies on).
# Windows installs usually provide `py` or `python` and either no `python3` or a Store placeholder.
for p in python3 python "py -3"; do
  if $p -c 'import sys; sys.exit(sys.version_info < (3, 11, 4))' >/dev/null 2>&1; then
    exec $p "$@"
  fi
done
echo "review: no Python 3.11.4 or newer found (tried python3, python and py -3)" >&2
exit 2  # 2, because a Claude Code hook that exits otherwise lets the call through
