#!/bin/sh
# Generated by os-aid-review-kit; `kit/global.py` points git's global core.hooksPath here.
# Every hook name in this directory is a stub that sources this file, so $0 is the hook's name. It runs for every repository on the machine that does not set its own core.hooksPath. It runs the
# repository's own hook of the same name first (lefthook, pre-commit, a hand-written script), since
# a global hooks path stops git from running those itself, and then the review gate: the repository's
# own kit where one is committed, the kit's ambient mode otherwise.
hook=$(basename "$0")
kit=$(cd "$(dirname "$0")/.." && pwd)
[ "$hook" = pre-push ] && input=$(cat)

feed() { if [ "$hook" = pre-push ]; then printf '%s\n' "$input" | "$@"; else "$@"; fi; }

own="$(git rev-parse --git-common-dir)/hooks/$hook"
if [ -x "$own" ]; then
  feed "$own" "$@" || exit $?
fi
case "$hook" in
  pre-commit|commit-msg|pre-push) ;;
  *) exit 0 ;;  # every other hook name is linked here only so the repository's own hook still runs
esac
if [ -f .review/bin/review.py ]; then
  if ! grep -q 'review.py' lefthook.yml 2>/dev/null; then
    echo "review: the kit is committed here but lefthook.yml does not run it; merge lefthook.yml.kit-proposed" >&2
    exit 1
  fi
  # an installed lefthook hook has just run the kit; anything else (pre-commit, husky's leftovers) has not
  [ -x "$own" ] && grep -q lefthook "$own" && exit 0
  # the kit is committed here but its hooks were never installed; lefthook refuses a global hooks path
  feed lefthook run "$hook" "$@"
  exit $?
fi
# --local, so `git -c review.ambient=false` or a global setting cannot switch the gate off
[ "$(git config --local --bool review.ambient)" = false ] && exit 0

review="$kit/kit/review.py"
py="$kit/kit/py"
case "$hook" in
  pre-commit)
    sh "$py" "$review" check || exit 1
    git diff --cached --name-only -z --diff-filter=ACMRT > "${TMPDIR:-/tmp}/review-staged.$$"
    if [ -s "${TMPDIR:-/tmp}/review-staged.$$" ]; then
      command -v trufflehog >/dev/null || { echo "review: trufflehog is not installed, so the secret scan cannot run" >&2; exit 1; }
      xargs -0 trufflehog filesystem --no-update --no-verification --fail --config "$kit/templates/trufflehog.yml" \
        < "${TMPDIR:-/tmp}/review-staged.$$"
      rc=$?
    else
      rc=0
    fi
    rm -f "${TMPDIR:-/tmp}/review-staged.$$"
    exit $rc ;;
  commit-msg) sh "$py" "$review" trailers "$1" ;;
  pre-push) feed sh "$py" "$review" check-push ;;
esac
